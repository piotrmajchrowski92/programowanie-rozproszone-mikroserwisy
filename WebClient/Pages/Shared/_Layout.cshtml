<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | System zgłoszeń</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header><div class="wrap"><span class="brand">System zgłoszeń</span>
        <span class="subtitle">C# · ASP.NET Core · API Gateway · JWT · SQLite</span></div></header>
    <main class="wrap">@RenderBody()</main>
    <footer class="wrap">Projekt edukacyjny. Wszystkie wywołania klienta przechodzą przez API Gateway.</footer>
</body>
</html>
